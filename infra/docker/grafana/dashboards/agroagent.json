{
  "uid": "agroagent-core",
  "title": "AgroAgent Core Metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "HTTP Avg Latency (ms)",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "agroagent_http_avg_latency_ms",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "type": "stat",
      "title": "HTTP Success Rate",
      "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "agroagent_http_success_rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },
    {
      "type": "stat",
      "title": "LLM Prompt Tokens",
      "id": 3,
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "agroagent_llm_prompt_tokens",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "LLM Completion Tokens",
      "id": 4,
      "gridPos": { "x": 6, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "agroagent_llm_completion_tokens",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Debate Avg Latency (ms)",
      "id": 5,
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "agroagent_debate_avg_latency_ms",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    }
  ]
}
